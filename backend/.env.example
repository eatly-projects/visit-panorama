PORT=4100
NODE_ENV=development

# Connection string Supabase lewat pooler mode Transaction (port 6543).
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Jangan pakai host db.<project>.supabase.co langsung: gagal di Vercel.
#
# Region fungsi Vercel di vercel.json ("dub1", Dublin) sengaja disamakan
# dengan region database (eu-west-1, Irlandia). Kalau database dipindah ke
# Singapore, ganti region di vercel.json jadi "sin1".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# String acak panjang untuk menandatangani sesi login.
JWT_SECRET=ganti-dengan-string-acak-panjang

# Hanya dipakai kalau backend dipanggil langsung dari domain lain.
CLIENT_ORIGIN=http://localhost:5180

# Akun petugas pertama untuk `npm run seed`.
SEED_OFFICER_NAME=Admin Resepsionis
SEED_OFFICER_EMAIL=admin@contoh.com
SEED_OFFICER_PASSWORD=ganti-password-ini
